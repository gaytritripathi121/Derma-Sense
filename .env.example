# ==============================================================================
# DermaSense AI — Environment Variables Template
# Copy to .env for local development or configure in Render Dashboard -> Environment.
# Never commit real secrets or database credentials to version control.
# ==============================================================================

# Runtime mode ('development' locally, 'production' on Render)
NODE_ENV="production"

# Server port (Render sets PORT automatically; defaults to 3000 locally)
PORT="3000"

# Planned production same-origin URL on Render
APP_URL="https://derma-sense.onrender.com"

# Optional comma-separated additional allowed CORS origins in production
CORS_ORIGINS="https://derma-sense.onrender.com"

# MongoDB Atlas connection string (required to enable user accounts & saved history;
# if left empty, DermaSense AI runs cleanly in Guest Mode).
# Format: mongodb+srv://<db_user>:<db_password>@<cluster_host>/dermasense?retryWrites=true&w=majority
MONGODB_URI=""

# Strong random secret used to HMAC-hash server-side authentication session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
